{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/src"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/*.egg-info/**": true
  }
}
