{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start: full run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start.py",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    },
    {
      "name": "Start: quick smoke test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start_quick.py",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    },
    {
      "name": "Start: TBR enumeration only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start_tbr_enumeration.py",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    },
    {
      "name": "Start: dry run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/start_dry_run.py",
      "cwd": "${workspaceFolder}",
      "env": {"PYTHONUTF8": "1"},
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    }
  ]
}
